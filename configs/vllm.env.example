# vLLM 环境变量样例（复制为 configs/vllm.env 或直接 export）
# BF16 权重约 772GB；FP8 约 386GB

# 权重目录（download_model.sh 生成：$MODEL_ROOT/<owner>__<name>）
MODEL_PATH=/models/zai-org__GLM-5.3-Flash-BF16

# 并行与容量
TENSOR_PARALLEL_SIZE=8        # 张量并行 GPU 数，= 物理 GPU 数
MAX_MODEL_LEN=131072          # 最大上下文；1M 需极大 KV，按显存量力而行
GPU_MEMORY_UTILIZATION=0.92   # 显存占用上限

# 服务
PORT=8000
SERVED_MODEL_NAME=glm-5.3-flash

# HF 下载（国内加速）
HF_ENDPOINT=https://hf-mirror.com
# HF_TOKEN=                 # gated 仓库时取消注释（勿提交真实 token）

# 追加参数示例（MTP 投机解码，需 nightly 版 vLLM）：
# EXTRA_ARGS=--speculative-config '{"method":"mtp","num_speculative_tokens":5}'
