# SGLang 环境变量样例（SGLang >= v0.5.20，推荐镜像 lmsysorg/sglang:latest）

MODEL_PATH=/models/zai-org__GLM-5.3-Flash-BF16

# 并行与容量
TENSOR_PARALLEL_SIZE=8        # --tp-size
MAX_MODEL_LEN=131072          # --context-length，按显存量力而行

# 服务
PORT=8000
SERVED_MODEL_NAME=glm-5.3-flash

# 追加参数示例（EAGLE/MTP 投机解码，低延迟场景）：
# EXTRA_ARGS=--speculative-algorithm EAGLE --speculative-num-steps 5 --speculative-eagle-topk 1 --speculative-num-draft-tokens 6
